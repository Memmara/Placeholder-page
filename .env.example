MEMMARA_PUBLIC_URL=http://localhost:5173
MEMMARA_DATABASE_URL=
MEMMARA_API_HOST=127.0.0.1
MEMMARA_API_PORT=5178
# Set only when a trusted local reverse proxy overwrites X-Forwarded-For.
MEMMARA_TRUSTED_PROXY=0
# Configure a transactional email sender for real verification and reset messages.
MEMMARA_RESEND_API_KEY=
MEMMARA_EMAIL_FROM=
# Register each callback as MEMMARA_PUBLIC_URL/api/auth/oauth/{provider}/callback.
MEMMARA_GOOGLE_CLIENT_ID=
MEMMARA_GOOGLE_CLIENT_SECRET=
MEMMARA_APPLE_SERVICE_ID=
MEMMARA_APPLE_TEAM_ID=
MEMMARA_APPLE_KEY_ID=
MEMMARA_APPLE_PRIVATE_KEY=
MEMMARA_MICROSOFT_CLIENT_ID=
MEMMARA_MICROSOFT_CLIENT_SECRET=

# Rewarded ads. Web uses a Google Ad Manager rewarded ad-unit path because
# ordinary AdSense display tags do not expose an earned-reward callback.
VITE_MEMMARA_ADSENSE_CLIENT=ca-pub-7297433574610458
VITE_MEMMARA_ADSENSE_GAME_SLOT=
VITE_MEMMARA_WEB_REWARDED_AD_UNIT=
VITE_MEMMARA_ADMOB_IOS_REWARDED_ID=
VITE_MEMMARA_ADMOB_IOS_BANNER_ID=
VITE_MEMMARA_ADMOB_ANDROID_APP_ID=ca-app-pub-7297433574610458~2374774011
VITE_MEMMARA_ADMOB_ANDROID_BANNER_ID=ca-app-pub-7297433574610458/1061692341
VITE_MEMMARA_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-7297433574610458/3496283993
# Local UI development only. The server rejects this provider in production.
VITE_MEMMARA_ADS_SIMULATE=0

# Stripe payments are disabled until every required key and price is configured.
MEMMARA_COMMERCE_ENABLED=0
MEMMARA_STRIPE_SECRET_KEY=
MEMMARA_STRIPE_PUBLISHABLE_KEY=
MEMMARA_STRIPE_WEBHOOK_SECRET=
MEMMARA_STRIPE_PRICE_TOKENS_5=
MEMMARA_STRIPE_PRICE_TOKENS_10=
MEMMARA_STRIPE_PRICE_PLUS=
MEMMARA_STRIPE_PRICE_PRO=
MEMMARA_STRIPE_PRICE_DOUGIE=
MEMMARA_STRIPE_PRICE_DOTTY=
